{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Attentracker",
  "version": "0.1.0",
  "identifier": "ro.kiyo.attentracker",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Attentracker",
        "width": 950,
        "height": 710,
        "minWidth": 550,
        "minHeight": 500
      }
    ],
    "security": {
      "capabilities": ["default"]
    }
  },
  "bundle": {
    "active": false
  }
}
